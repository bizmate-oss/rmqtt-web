# ---------------------------------------------------------------------------
# rmqtt-web — copy to `.env` and adjust.
# Everything here is read at runtime, so one build can serve any cluster.
# ---------------------------------------------------------------------------

# --- HTTP API (rmqtt-http-api plugin) --------------------------------------
# Base URL of the broker's API listener, without the /api/v1 suffix.
RMQTT_API_URL=http://127.0.0.1:6060

# Only needed when `http_bearer_token` is set in plugins/rmqtt-http-api.toml.
# It stays on the server: the browser talks to /api/rmqtt/* and never sees it.
RMQTT_API_TOKEN=

RMQTT_API_TIMEOUT_MS=10000

# --- MQTT (for $SYS live data and the topic monitor) -----------------------
# The dashboard *server* opens this connection, not the browser. Set it empty
# to turn live streaming off and run on HTTP polling alone.
RMQTT_MQTT_URL=mqtt://127.0.0.1:1883

# rmqtt's built-in ACL grants $SYS/# to the username `dashboard` from any
# address; every other user only gets it from the broker's own host. Keep this
# aligned with plugins/rmqtt-acl.toml.
RMQTT_MQTT_USERNAME=dashboard
RMQTT_MQTT_PASSWORD=
RMQTT_MQTT_CLIENT_ID=

# Ceiling on messages/second relayed to a single browser tab, so a monitor
# aimed at a busy wildcard cannot starve the shared broker connection.
RMQTT_MONITOR_RATE_LIMIT=500
